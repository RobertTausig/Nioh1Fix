{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 2
  },
  "configurePresets": [
    {
      "name": "linux-clang",
      "displayName": "Linux · pinned Clang",
      "description": "Native Linux tests with the verified LLVM-MinGW Clang toolchain.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "NIOH1FIX_REQUIRE_PINNED_CLANG": "ON"
      }
    },
    {
      "name": "windows-llvm-mingw",
      "displayName": "Windows · pinned LLVM-MinGW",
      "description": "Windows plugin cross-build with the verified LLVM-MinGW release.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows-clang",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-clang++",
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "NIOH1FIX_REQUIRE_PINNED_CLANG": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "jobs": 2
    },
    {
      "name": "windows-llvm-mingw",
      "configurePreset": "windows-llvm-mingw",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
